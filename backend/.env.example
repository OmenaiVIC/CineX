# ── CineX Backend Environment ──────────────────────────────────────────────
# Copy to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:xxxxx@ep-xxxxx.us-east-2.aws.neon.tech/cinex?sslmode=require
# Optional: force the serverless driver even in local dev (default: auto-detect)
# NEON_DRIVER=serverless

# ── Stack Network ──────────────────────────────────────────────────────────
# "testnet" (default) or "mainnet". Controls Hiro API URL + USDCx contract address.
STACKS_NETWORK=testnet

# ── Base URL (for webhook callbacks) ───────────────────────────────────────
# Defaults to https://cine-x-api.vercel.app in production code.
# Override here for local dev if needed.
# BASE_URL=http://localhost:3001

# ── Stack Keys (smart contract broadcasting) ──────────────────────────────
CREATOR_KEY=
BACKER_KEY=

# ── Passkey Relay ────────────────────────────────────────────────────────
RELAY_ADDRESS=
RELAY_API_KEY=

# ── AI Credibility (§11.5) ─────────────────────────────────────────────────
# Optional: OpenAI API key for AI-generated credibility summaries on profile pages.
# When unset, the endpoint returns a generic fallback summary.
# OPENAI_API_KEY=sk-...

# ── Auth ───────────────────────────────────────────────────────────────────
ADMIN_BOOTSTRAP_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_USER=
SMTP_PASS=

# ── Vercel / Deployment ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend URLs (for CORS) ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── BOS — xReserve (USDCx bridge attestation) ──────────────────────────────
# Sandbox: https://sandbox.xreserve.com/v1 | Production: https://api.xreserve.com/v1
XRESERVE_API_URL=
XRESERVE_API_KEY=
# 'sandbox' | 'production'
XRESERVE_ENV=production
# Webhook signature verification secret (optional for MVP, poll-only)
# XRESERVE_WEBHOOK_SECRET=

# ── BOS — Yellow Card (NGN payout) ────────────────────────────────────────
# Sandbox: https://sandbox-api.yellowcard.io/business | Production: https://api.yellowcard.io/business
YELLOW_CARD_API_URL=
YELLOW_CARD_API_KEY=
YELLOW_CARD_SECRET_KEY=
# 'sandbox' | 'production'
YELLOW_CARD_ENV=production
# Webhook signature verification secret
# YELLOW_CARD_WEBHOOK_SECRET=

# ── BOS — Pipeline Worker ──────────────────────────────────────────────────
# BOS_PIPELINE_INTERVAL_MS=30000
# BOS_PIPELINE_BATCH_SIZE=10

# ── BOS — Payout Caps (§7.6) ────────────────────────────────────────────────
# Maximum USD amount allowed per individual disbursement (set to disable gate)
# BOS_MAX_PER_DISBURSEMENT_USD=5000
# Maximum aggregate USD payout in any rolling 24-hour window (set to disable gate)
# BOS_DAILY_PAYOUT_CAP_USD=50000

# ── Demo Mode ──────────────────────────────────────────────────────────────
# VITE_USE_MOCK_DATA=true
# DEMO_CONTRACT_ADDR=
